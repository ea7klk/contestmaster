APP_ENV=development
DATABASE_URL=sqlite:///./var/contestmaster.db
SQLITE_BUSY_TIMEOUT_MS=5000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:5173"]
SECURE_COOKIES=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
FRONTEND_BASE_URL=http://localhost:5173
ENTRY_RECEIPT_SECRET=development-only-change-before-deploy
MASTER_DATA_SCHEDULER_ENABLED=true
MASTER_DATA_NIGHTLY_HOUR_UTC=2
CONTEST_SCHEDULER_ENABLED=true
CONTEST_SCHEDULER_INTERVAL_SECONDS=3600
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
