{
  "schema_version": 2,
  "ruleset_key": "vhf-uhf-ft8-activity",
  "version": "2026-draft",
  "source_url": "https://ft8activity.eu/rules/",
  "source_edition": "2026 example draft (October 144 MHz round); starter only, compare with linked official rules before use",
  "rules": [
    {
      "id": "submission",
      "rule": {
        "kind": "submission",
        "late_policy": "checklog",
        "manager_extension_allowed": false
      }
    },
    {
      "id": "categories",
      "rule": {
        "kind": "categories",
        "dimensions": [
          {
            "key": "operator",
            "label": "Operator configuration",
            "required": true,
            "choices": [
              {
                "key": "single_operator",
                "label": "Single operator"
              },
              {
                "key": "multi_operator",
                "label": "Multi operator"
              }
            ]
          },
          {
            "key": "power",
            "label": "Power class",
            "required": true,
            "choices": [
              {
                "key": "qrp",
                "label": "QRP"
              },
              {
                "key": "low",
                "label": "Low power"
              },
              {
                "key": "high",
                "label": "High power"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "exchange",
      "rule": {
        "kind": "exchange",
        "fields": [
          {
            "key": "grid",
            "label": "Maidenhead grid locator",
            "value_type": "grid",
            "direction": "both",
            "required": true,
            "max_length": 6
          }
        ]
      }
    },
    {
      "id": "eligibility",
      "rule": {
        "kind": "eligibility",
        "allowed_bands": [
          "2m"
        ],
        "allowed_modes": [
          "FT8",
          "FT4"
        ],
        "reject_self_contacts": true,
        "reject_out_of_period": true,
        "reject_missing_required_exchange": true,
        "action": "not_credited"
      }
    },
    {
      "id": "duplicates",
      "rule": {
        "kind": "duplicates",
        "scope": [
          "worked_callsign",
          "band"
        ],
        "effect": "not_credited",
        "penalty_points": 0
      }
    },
    {
      "id": "points",
      "rule": {
        "kind": "points",
        "fact": "fixed",
        "fixed_points": 1
      }
    },
    {
      "id": "score-formula",
      "rule": {
        "kind": "score_formula",
        "start": {
          "variable": "points_total"
        },
        "steps": [
          {
            "operator": "multiply",
            "operand": {
              "variable": "multiplier_count"
            }
          }
        ]
      }
    },
    {
      "id": "format-mapping",
      "rule": {
        "kind": "format_mapping",
        "format": "adif",
        "preserve_unknown_fields": true,
        "category_mappings": [
          {
            "external_field": "CATEGORY-OPERATOR", "external_value": "SINGLE-OP",
            "category_values": {
              "operator": "single_operator"
            }
          },
          {
            "external_field": "CATEGORY-OPERATOR", "external_value": "MULTI-OP",
            "category_values": {
              "operator": "multi_operator"
            }
          },
          {
            "external_field": "CATEGORY-POWER", "external_value": "QRP",
            "category_values": {
              "power": "qrp"
            }
          },
          {
            "external_field": "CATEGORY-POWER", "external_value": "LOW",
            "category_values": {
              "power": "low"
            }
          },
          {
            "external_field": "CATEGORY-POWER", "external_value": "HIGH",
            "category_values": {
              "power": "high"
            }
          }
        ]
      }
    },
    {
      "id": "multiplier-1",
      "rule": {
        "kind": "multiplier",
        "source_fact": "qso.grid",
        "scope": "band",
        "label": "Grid square"
      }
    }
  ]
}
