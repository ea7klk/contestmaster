{
  "schema_version": 2,
  "ruleset_key": "world-wide-digi-dx",
  "version": "2026-draft",
  "source_url": "https://ww-digi.com/rules/",
  "source_edition": "2026 example draft; starter only, compare with linked official rules before use",
  "rules": [
    {
      "id": "submission",
      "rule": {
        "kind": "submission",
        "late_policy": "checklog",
        "manager_extension_allowed": false
      }
    },
    {
      "id": "categories",
      "rule": {
        "kind": "categories",
        "dimensions": [
          {
            "key": "operator",
            "label": "Operator configuration",
            "required": true,
            "choices": [
              {
                "key": "single_operator",
                "label": "Single operator"
              },
              {
                "key": "multi_operator",
                "label": "Multi operator"
              }
            ]
          },
          {
            "key": "power",
            "label": "Power class",
            "required": true,
            "choices": [
              {
                "key": "qrp",
                "label": "QRP"
              },
              {
                "key": "low",
                "label": "Low power"
              },
              {
                "key": "high",
                "label": "High power"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "exchange",
      "rule": {
        "kind": "exchange",
        "fields": [
          {
            "key": "grid",
            "label": "Maidenhead grid locator",
            "value_type": "grid",
            "direction": "both",
            "required": true,
            "max_length": 6
          }
        ]
      }
    },
    {
      "id": "eligibility",
      "rule": {
        "kind": "eligibility",
        "allowed_bands": [
          "160m",
          "80m",
          "40m",
          "20m",
          "15m",
          "10m"
        ],
        "allowed_modes": [
          "FT4",
          "FT8"
        ],
        "reject_self_contacts": true,
        "reject_out_of_period": true,
        "reject_missing_required_exchange": true,
        "action": "not_credited"
      }
    },
    {
      "id": "duplicates",
      "rule": {
        "kind": "duplicates",
        "scope": [
          "worked_callsign",
          "band"
        ],
        "effect": "not_credited",
        "penalty_points": 0
      }
    },
    {
      "id": "points",
      "rule": {
        "kind": "points",
        "fact": "fixed",
        "fixed_points": 1
      }
    },
    {
      "id": "score-formula",
      "rule": {
        "kind": "score_formula",
        "start": {
          "variable": "points_total"
        },
        "steps": [
          {
            "operator": "multiply",
            "operand": {
              "variable": "multiplier_count"
            }
          }
        ]
      }
    },
    {
      "id": "format-mapping",
      "rule": {
        "kind": "format_mapping",
        "format": "cabrillo",
        "qso_columns": [
          "frequency",
          "mode",
          "date",
          "time",
          "callsign_sent",
          "rst_sent",
          "exchange_sent",
          "callsign_received",
          "rst_received",
          "exchange_received"
        ],
        "category_mappings": [
          {"external_value": "SINGLE-OP", "category_values": {"operator": "single_operator"}},
          {"external_value": "MULTI-OP", "category_values": {"operator": "multi_operator"}},
          {"external_value": "QRP", "category_values": {"power": "qrp"}},
          {"external_value": "LOW", "category_values": {"power": "low"}},
          {"external_value": "HIGH", "category_values": {"power": "high"}}
        ],
        "preserve_unknown_fields": true
      }
    },
    {
      "id": "multiplier-1",
      "rule": {
        "kind": "multiplier",
        "source_fact": "qso.grid",
        "scope": "band",
        "label": "Grid square"
      }
    }
  ]
}
