{
  "sponsor": "Radio Society of Great Britain",
  "edition": "VHF/UHF/SHF General Rules 2026",
  "rules_url": "https://www.rsgbcc.org/vhf/rules/26rules/General.shtml",
  "accepted_format": "cabrillo",
  "ruleset_key": "rsgb-vhf-2026-distance-sessions-conformance",
  "ruleset_version": "2026-general-fixture-1",
  "entrant": {
    "callsign": "G0OUT",
    "category_operator": "SINGLE-OP",
    "grid": "IO91AA"
  },
  "ruleset": {
    "schema_version": 2,
    "ruleset_key": "rsgb-vhf-2026-distance-sessions-conformance",
    "version": "2026-general-fixture-1",
    "source_url": "https://www.rsgbcc.org/vhf/rules/26rules/General.shtml",
    "source_edition": "2026 general rules; simplified Cabrillo conformance fixture",
    "rules": [
      {
        "id": "submission",
        "rule": {
          "kind": "submission",
          "late_policy": "checklog"
        }
      },
      {
        "id": "categories",
        "rule": {
          "kind": "categories",
          "dimensions": [
            {
              "key": "operator",
              "label": "Operator",
              "choices": [
                {
                  "key": "single",
                  "label": "Single operator"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "exchange",
        "rule": {
          "kind": "exchange",
          "fields": [
            {
              "key": "serial",
              "label": "Serial number",
              "value_type": "serial",
              "direction": "sent",
              "required": true,
              "serial_scope": "band"
            },
            {
              "key": "grid",
              "label": "Maidenhead locator",
              "value_type": "grid",
              "direction": "received",
              "required": true,
              "max_length": 6
            }
          ]
        }
      },
      {
        "id": "eligibility",
        "rule": {
          "kind": "eligibility",
          "allowed_bands": [
            "2m"
          ],
          "allowed_modes": [
            "CW"
          ]
        }
      },
      {
        "id": "duplicates",
        "rule": {
          "kind": "duplicates",
          "scope": [
            "worked_callsign",
            "band"
          ],
          "effect": "not_credited"
        }
      },
      {
        "id": "distance-points",
        "rule": {
          "kind": "distance_points",
          "precision": 6,
          "points_per_kilometer": 1,
          "same_grid_points": 1,
          "missing_grid_action": "needs_review"
        }
      },
      {
        "id": "base-points",
        "rule": {
          "kind": "points",
          "fact": "fixed",
          "fixed_points": 0
        }
      },
      {
        "id": "session-resets",
        "rule": {
          "kind": "session_resets",
          "period_minutes": 60,
          "serial_start_value": 1,
          "reset_duplicates": true,
          "reset_multipliers": false,
          "reset_serials": true
        }
      },
      {
        "id": "score-formula",
        "rule": {
          "kind": "score_formula",
          "start": {
            "variable": "points_total"
          }
        }
      },
      {
        "id": "format-mapping",
        "rule": {
          "kind": "format_mapping",
          "format": "cabrillo",
          "qso_columns": [
            "frequency",
            "mode",
            "date",
            "time",
            "callsign_sent",
            "rst_sent",
            "exchange_sent",
            "callsign_received",
            "rst_received",
            "exchange_received"
          ],
          "header_fields": {
            "contest": "CONTEST",
            "callsign": "CALLSIGN"
          },
          "category_mappings": [
            {
              "external_field": "CATEGORY-OPERATOR",
              "external_value": "SINGLE-OP",
              "category_values": {
                "operator": "single"
              }
            }
          ]
        }
      }
    ]
  },
  "contacts": [
    {
      "worked_callsign": "G1GRID",
      "sent_serial": 1,
      "received_grid": "IO91AA",
      "expected_session": 1,
      "expected_points": 1
    },
    {
      "worked_callsign": "G1GRID",
      "sent_serial": 1,
      "received_grid": "IO92AA",
      "expected_session": 2,
      "expected_points": 112
    }
  ],
  "expected": {
    "credited_qsos": 2,
    "qso_points": 113,
    "multiplier_counts": {},
    "bonus_counts": {},
    "bonus_points": 0,
    "penalty_points": 0,
    "final_score": 113
  },
  "notes": [
    "This fixture verifies the general rules' identical-six-character-locator award and one point per commenced kilometer, using Contestmaster's documented 6-character cell-center distance convention.",
    "The same station is worked in two separate one-hour sessions; duplicate identity resets and sent serials restart at 001 as configured.",
    "The fixture is not an official RSGB activity calendar. Its two fixed sessions test the reset primitive, not cumulative event scheduling or every RSGB contest-specific rule."
  ]
}
