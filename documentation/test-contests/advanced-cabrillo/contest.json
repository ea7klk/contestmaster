{
  "contest": {
    "name": "Contestmaster Advanced Cabrillo Rules Challenge",
    "slug": "test-advanced-cabrillo-rules-challenge",
    "description": "Synthetic historical contest fixture combining several supported rule types. All callsigns, exchanges, participants, and QSOs are fictional and intended only for development and demonstrations.",
    "starts_at": "2024-09-14T12:00:00Z",
    "ends_at": "2024-09-14T18:00:00Z",
    "periodicity": null,
    "log_submission_cutoff_at": "2099-12-31T23:59:59Z",
    "auto_recalculate_on_upload": false
  },
  "ruleset": {
    "schema_version": 2,
    "ruleset_key": "test-advanced-cabrillo-rules-challenge",
    "version": "1.0",
    "source_url": null,
    "source_edition": "Contestmaster synthetic rules coverage fixture",
    "rules": [
      {
        "id": "submission",
        "rule": {
          "kind": "submission",
          "late_policy": "accept_late",
          "manager_extension_allowed": false
        }
      },
      {
        "id": "publication-policy",
        "rule": {
          "kind": "workflow_hook",
          "stage": "publication",
          "key": "synthetic-test-results",
          "execution": "automatic",
          "parameters": {
            "include_late": true,
            "include_needs_review": false
          }
        }
      },
      {
        "id": "categories",
        "rule": {
          "kind": "categories",
          "dimensions": [
            {
              "key": "operator",
              "label": "Operator",
              "required": true,
              "choices": [
                {
                  "key": "multi",
                  "label": "Multi operator"
                }
              ]
            },
            {
              "key": "power",
              "label": "Power",
              "required": true,
              "choices": [
                {
                  "key": "qrp",
                  "label": "QRP"
                },
                {
                  "key": "low",
                  "label": "Low power"
                },
                {
                  "key": "high",
                  "label": "High power"
                }
              ]
            },
            {
              "key": "band_class",
              "label": "Band category",
              "required": true,
              "choices": [
                {
                  "key": "all_bands",
                  "label": "All bands"
                }
              ]
            },
            {
              "key": "mode",
              "label": "Mode category",
              "required": true,
              "choices": [
                {
                  "key": "cw",
                  "label": "CW"
                }
              ]
            },
            {
              "key": "overlay",
              "label": "Overlay",
              "required": false,
              "choices": [
                {
                  "key": "rookie",
                  "label": "Rookie"
                },
                {
                  "key": "none",
                  "label": "No overlay"
                }
              ]
            },
            {
              "key": "transmitter_count",
              "label": "Transmitters",
              "required": true,
              "choices": [
                {
                  "key": "two",
                  "label": "Two transmitters"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "exchange",
        "rule": {
          "kind": "exchange",
          "fields": [
            {
              "key": "serial",
              "label": "Serial number",
              "value_type": "serial",
              "direction": "both",
              "required": true,
              "max_length": 6,
              "serial_scope": "entry"
            }
          ]
        }
      },
      {
        "id": "eligibility",
        "rule": {
          "kind": "eligibility",
          "eligible_if": {
            "kind": "all",
            "conditions": [
              {
                "kind": "compare",
                "fact": "qso.band",
                "operator": "in",
                "value": [
                  "20m",
                  "40m",
                  "15m",
                  "10m"
                ]
              },
              {
                "kind": "compare",
                "fact": "qso.mode",
                "operator": "in",
                "value": [
                  "CW"
                ]
              }
            ]
          },
          "allowed_bands": [
            "20m",
            "40m",
            "15m",
            "10m"
          ],
          "allowed_modes": [
            "CW"
          ],
          "reject_self_contacts": true,
          "reject_out_of_period": true,
          "reject_missing_required_exchange": true,
          "action": "not_credited"
        }
      },
      {
        "id": "duplicate-contact-penalty",
        "rule": {
          "kind": "duplicates",
          "scope": [
            "worked_callsign",
            "band",
            "mode"
          ],
          "effect": "penalty",
          "penalty_points": 5
        }
      },
      {
        "id": "base-points",
        "rule": {
          "kind": "points",
          "fact": "fixed",
          "fixed_points": 2
        }
      },
      {
        "id": "mode-points",
        "rule": {
          "kind": "points",
          "fact": "mode",
          "values": {
            "CW": 5
          },
          "default_points": 0
        }
      },
      {
        "id": "band-points",
        "rule": {
          "kind": "points",
          "fact": "band",
          "values": {
            "20m": 4,
            "40m": 4,
            "15m": 4,
            "10m": 4
          },
          "default_points": 0
        }
      },
      {
        "id": "received-serial-points",
        "rule": {
          "kind": "points",
          "fact": "exchange",
          "exchange_field": "serial",
          "values": {
            "1": 5,
            "2": 4,
            "3": 3
          },
          "default_points": 1
        }
      },
      {
        "id": "worked-call-multiplier",
        "rule": {
          "kind": "multiplier",
          "source_fact": "qso.worked_callsign",
          "scope": "contest",
          "label": "Unique callsigns"
        }
      },
      {
        "id": "received-serial-multiplier",
        "rule": {
          "kind": "multiplier",
          "source_fact": "exchange.received.serial",
          "scope": "contest",
          "label": "Unique received serials"
        }
      },
      {
        "id": "mode-band-multiplier",
        "rule": {
          "kind": "multiplier",
          "source_fact": "qso.mode",
          "scope": "band",
          "label": "Modes per band"
        }
      },
      {
        "id": "high-power-bonus",
        "rule": {
          "kind": "bonus",
          "basis": "per_entry",
          "points": 100000,
          "cap": 100000,
          "minimum_eligible_qsos": 10
        },
        "when": {
          "kind": "compare",
          "fact": "entry.categories.power",
          "operator": "eq",
          "value": "high"
        }
      },
      {
        "id": "low-serial-point-penalty",
        "rule": {
          "kind": "penalty",
          "reason_code": "low-serial-adjustment",
          "action": "deduct_points",
          "points": 3,
          "maximum_occurrences": 1
        },
        "when": {
          "kind": "compare",
          "fact": "exchange.received.serial",
          "operator": "eq",
          "value": 1
        }
      },
      {
        "id": "low-serial-contact-removal",
        "rule": {
          "kind": "penalty",
          "reason_code": "low-serial-review",
          "action": "remove_contact",
          "maximum_occurrences": 1
        },
        "when": {
          "kind": "compare",
          "fact": "exchange.received.serial",
          "operator": "eq",
          "value": 1
        }
      },
      {
        "id": "operating-limits",
        "rule": {
          "kind": "operating_constraints",
          "max_operating_minutes": 180,
          "operating_session_gap_minutes": 60,
          "minimum_off_time_minutes": 60,
          "required_off_periods": 1,
          "off_period_gap_minutes": 60,
          "maximum_band_changes": 1,
          "band_change_window_minutes": 60,
          "minimum_band_dwell_minutes": 60,
          "maximum_transmitters": 2
        }
      },
      {
        "id": "award-workflow",
        "rule": {
          "kind": "workflow_hook",
          "stage": "award",
          "key": "synthetic-award-review",
          "execution": "automatic",
          "parameters": {}
        }
      },
      {
        "id": "scoring-session-resets",
        "rule": {
          "kind": "session_resets",
          "period_minutes": 60,
          "serial_start_value": 1,
          "reset_duplicates": true,
          "reset_multipliers": true,
          "reset_serials": false
        }
      },
      {
        "id": "score-formula",
        "rule": {
          "kind": "score_formula",
          "start": {
            "variable": "multiplier.worked-call-multiplier"
          },
          "steps": [
            {
              "operator": "add",
              "operand": {
                "variable": "multiplier.received-serial-multiplier"
              }
            },
            {
              "operator": "add",
              "operand": {
                "variable": "multiplier.mode-band-multiplier"
              }
            },
            {
              "operator": "multiply",
              "operand": {
                "variable": "points_total"
              }
            },
            {
              "operator": "add",
              "operand": {
                "variable": "bonus_points"
              }
            },
            {
              "operator": "subtract",
              "operand": {
                "variable": "penalty_points"
              }
            }
          ]
        }
      },
      {
        "id": "cabrillo-format",
        "rule": {
          "kind": "format_mapping",
          "format": "cabrillo",
          "category_mappings": [
            {
              "external_field": "CATEGORY-OPERATOR",
              "external_value": "MULTI-OP",
              "category_values": {
                "operator": "multi"
              }
            },
            {
              "external_field": "CATEGORY-POWER",
              "external_value": "QRP",
              "category_values": {
                "power": "qrp"
              }
            },
            {
              "external_field": "CATEGORY-POWER",
              "external_value": "LOW",
              "category_values": {
                "power": "low"
              }
            },
            {
              "external_field": "CATEGORY-POWER",
              "external_value": "HIGH",
              "category_values": {
                "power": "high"
              }
            },
            {
              "external_field": "CATEGORY-BAND",
              "external_value": "ALL",
              "category_values": {
                "band_class": "all_bands"
              }
            },
            {
              "external_field": "CATEGORY-OVERLAY",
              "external_value": "ROOKIE",
              "category_values": {
                "overlay": "rookie"
              }
            },
            {
              "external_field": "CATEGORY-MODE",
              "external_value": "CW",
              "category_values": {
                "mode": "cw"
              }
            },
            {
              "external_field": "CATEGORY-TRANSMITTER",
              "external_value": "TWO",
              "category_values": {
                "transmitter_count": "two"
              }
            }
          ],
          "preserve_unknown_fields": true,
          "header_fields": {
            "callsign": "CALLSIGN",
            "contest": "CONTEST"
          },
          "qso_columns": [
            "frequency",
            "mode",
            "date",
            "time",
            "callsign_sent",
            "rst_sent",
            "exchange_sent",
            "callsign_received",
            "rst_received",
            "exchange_received",
            "transmitter"
          ]
        }
      }
    ]
  }
}
