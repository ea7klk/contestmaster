{
  "contest": {
    "name": "Contestmaster Cabrillo Test Sprint",
    "slug": "test-cabrillo-results-sprint",
    "description": "Synthetic past-event contest for exercising Cabrillo 3.0 imports and anonymous log uploads. All participant and contact data is fictional.",
    "starts_at": "2024-09-14T12:00:00Z",
    "ends_at": "2024-09-14T18:00:00Z",
    "periodicity": null,
    "log_submission_cutoff_at": "2099-12-31T23:59:59Z",
    "auto_recalculate_on_upload": false
  },
  "ruleset": {
    "schema_version": 2,
    "ruleset_key": "test-cabrillo-results-sprint",
    "version": "1.0",
    "source_url": null,
    "source_edition": "Contestmaster synthetic upload fixture",
    "rules": [
      {"id": "submission", "rule": {"kind": "submission", "late_policy": "accept_late", "manager_extension_allowed": false}},
      {"id": "publication-policy", "rule": {"kind": "workflow_hook", "stage": "publication", "key": "synthetic-test-results", "execution": "automatic", "parameters": {"include_late": true}}},
      {"id": "categories", "rule": {"kind": "categories", "dimensions": [{"key": "operator", "label": "Operator class", "required": false, "choices": [{"key": "single", "label": "Single operator"}]}]}},
      {"id": "exchange", "rule": {"kind": "exchange", "fields": [{"key": "serial", "label": "Serial number", "value_type": "serial", "direction": "both", "required": true, "max_length": 6, "serial_scope": "entry"}]}},
      {"id": "eligibility", "rule": {"kind": "eligibility", "reject_self_contacts": true, "reject_out_of_period": true, "reject_missing_required_exchange": true, "action": "not_credited"}},
      {"id": "duplicates", "rule": {"kind": "duplicates", "scope": ["worked_callsign", "band"], "effect": "not_credited", "penalty_points": 0}},
      {"id": "points", "rule": {"kind": "points", "fact": "fixed", "fixed_points": 1}},
      {"id": "score-formula", "rule": {"kind": "score_formula", "start": {"variable": "points_total"}, "steps": []}},
      {"id": "format-mapping", "rule": {"kind": "format_mapping", "format": "cabrillo", "preserve_unknown_fields": true}}
    ]
  }
}
